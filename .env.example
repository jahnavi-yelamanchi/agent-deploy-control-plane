# Copy to .env. Defaults run fully offline (mock provider, in-process fallbacks).

# --- mode ---
MODEL_PROVIDER=mock              # mock | real (scripts/bootstrap.sh flips this)
BACKEND=local                    # local (sqlite/in-memory) | services (redis/postgres/kafka/mlflow)

# --- runtime ---
AGENT_SPEC_PATH=specs/v1.yaml    # ADCP_SPEC_PATH also accepted
# ADCP_SPEC_ALIAS=production     # load from MLflow registry alias instead of a file
ADCP_TRACK=stable                # stable | canary; overridden by ADCP_TRACK_LABELS_FILE label adcp.dev/track
# ADCP_TRACK_LABELS_FILE=/etc/podinfo/labels
ADCP_ROLLOUT_STEP=0              # flag targeting context (rolloutStep)
PORT=8080

# --- model providers (only with MODEL_PROVIDER=real) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AWS_REGION=us-east-1             # Bedrock; credentials via default chain / IRSA on EKS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_AI_ENDPOINT=               # Azure AI Foundry models endpoint (azure-ai-inference)
AZURE_OPENAI_ENDPOINT=           # Azure OpenAI; takes precedence over AZURE_AI_ENDPOINT
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_CLIENT_ID=                 # Entra workload identity (AKS injects AZURE_FEDERATED_TOKEN_FILE)
AZURE_TENANT_ID=
VLLM_BASE_URL=http://localhost:8000/v1
SGLANG_BASE_URL=http://localhost:30000/v1

# --- MCP ---
MCP_TRANSPORT=stdio              # stdio | streamable-http (python -m adcp.runtime.mcp_server)
MCP_PORT=8000
TAU_MCP_URL=http://localhost:8000/mcp
# TAU_TASK_ID=airline-001        # serve one task's DB; unset merges all

# --- services (BACKEND=services) ---
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://adcp:adcp@localhost:5432/adcp
KAFKA_BOOTSTRAP=localhost:19092  # redpanda:9092 in-network
FLAGD_HOST=                      # unset -> flagd in-process resolver on FLAGS_FILE
FLAGD_PORT=8013
FLAGS_FILE=flags/flags.flagd.json

# --- MLflow registry ---
MLFLOW_TRACKING_URI=sqlite:///.mlflow/mlflow.db   # services: http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=.mlflow/artifacts
REGISTERED_MODEL_NAME=support-agent
MLFLOW_S3_ENDPOINT_URL=          # MinIO, e.g. http://minio:9000 (with AWS_ACCESS_KEY_ID/SECRET)

# --- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. http://localhost:4318; unset -> in-memory metrics
SERVICE_NAME=agent-runtime
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
PROMETHEUS_URL=http://localhost:9090

# --- rollout / CI ---
ARGO_ROLLOUTS_NAMESPACE=agents
ARGO_ROLLOUT_NAME=agent-runtime
GITHUB_TOKEN=
