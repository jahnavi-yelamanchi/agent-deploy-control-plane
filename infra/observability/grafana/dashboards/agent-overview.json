        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Rollout decisions",
        "expr": "sum by (decision, reason) (changes(adcp_rollback_events_total[1m])) > 0",
        "step": "60s",
        "titleFormat": "{{decision}}",
        "textFormat": "{{reason}}",
        "tagKeys": "decision,reason",
        "useValueForTime": false
      }
    ]
